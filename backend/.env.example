# Set these as environment variables before starting the backend
# (or in your host's dashboard, e.g. Render → Environment).

# Required in production: a long random string used to sign login tokens.
SECRET_KEY=

# "production" hides the test OTP that development mode shows on screen.
APP_ENV=development

# ── Phone OTP (SMS) ── pick one provider; leave empty for development mode
SMS_PROVIDER=            # fast2sms | msg91 | twilio
FAST2SMS_API_KEY=
# If Fast2SMS says the OTP route is not enabled, change this to q (Quick SMS)
FAST2SMS_ROUTE=otp
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=       # DLT-approved OTP template
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ── Google sign-in ── OAuth "Web application" client ID from Google Cloud Console.
# Add http://localhost:5173 (and your live site) to "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=

# ── Live mandi prices ── free personal key from https://data.gov.in (faster than the sample key)
DATA_GOV_IN_API_KEY=
